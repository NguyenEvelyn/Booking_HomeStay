{
  "name": "homestay-auth-frontend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "test": "node --test src/**/*.test.js",
    "build:mobile": "vite build --mode mobile",
    "preview": "vite preview",
    "mobile:sync": "npm run build:mobile && cap sync",
    "mobile:sync:android": "npm run build:mobile && cap sync android",
    "mobile:sync:ios": "npm run build:mobile && cap sync ios",
    "mobile:open": "cap open android",
    "mobile:run": "npm run mobile:sync:android && cap run android",
    "mobile:build": "npm run mobile:sync:android && cd android && gradlew.bat assembleDebug"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/app": "^8.1.2",
    "@capacitor/browser": "^8.0.5",
    "@capacitor/core": "^8.5.2",
    "@capacitor/ios": "^8.5.3",
    "@capacitor/keyboard": "^8.0.6",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.4",
    "@vitejs/plugin-react": "^4.4.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "vite": "^6.3.5"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.2"
  }
}
