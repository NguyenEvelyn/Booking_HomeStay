PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Neon/Supabase PostgreSQL. Paste the pooled connection string from the provider.
# Never commit the real value.
DATABASE_URL=Host=your-host;Port=5432;Database=neondb;Username=your_user;Password=your_password;SSL Mode=Require

# Supabase Storage (bucket public). Secret key must only be used by the backend.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=sb_secret_your_server_key
SUPABASE_STORAGE_BUCKET=homestay-images

# Required before Google/Facebook OAuth can be enabled.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

JWT_SECRET=homestay_jwt_secret_key_2026_change_to_a_long_random_value
JWT_EXPIRES_HOURS=24
JWT_REMEMBER_HOURS=720
JWT_ISSUER=Tripio
JWT_AUDIENCE=Tripio.Web
OTP_HASH_SECRET=replace_with_an_independent_long_random_secret
COOKIE_MAX_AGE_MS=86400000

# VNPay Sandbox
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
VNPAY_PAYMENT_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_RETURN_URL=http://localhost:5000/api/bookings/vnpay-return
# Khai báo URL IPN này trên trang quản trị merchant VNPay:
# https://your-api-domain/api/bookings/vnpay-ipn

# SMTP dùng để gửi mã OTP xác minh email.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=noreply@tripio.vn
